# Copy to .env for local testing. On Vercel add the same names under Project → Settings → Environment Variables.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-text
# Optional: extra domains allowed to create orders (comma separated), e.g. www.reikisurat.in
ALLOWED_HOSTS=reikisurat.in,www.reikisurat.in
